<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOMENT - Flower Stores </title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="images/png" href="/images/MOMENT-LOGO.jpg">

</head>

<body>
    <%- include('./partials/navbar') %>


        <section class="page-header">
            <h1>Flower Stores</h1>
            <p>Find beautiful flowers for every special moment .</p>
        </section>

        <section class="stores-container">
            <% if(stores && stores.length >0){ %>
                <% stores.forEach(store=> { %>
                    <div class="store-card">

                    <img
                    src="/images/<%=store.image %>"
                    alt="<%=store.name%>"
                    >

                    <div class="store-card-content">
                        <h2>
                            <%=store.name %>
                            </h2>

                            <p>
                                <%=store.description %>
                            </p>

                            <a 
                            href="/stores/<%=store._id%>"
                            class="btn">
                            View Store
                        </a>
                        </div>
                    </div>
                    <% }) %>

                    <%} else{%>
                        <p class="empty-message">
                            No flower stores available yet.
                        </p>

                        <% } %>
        </section>
    </main>
    <%- include("./partials/footer") %>

</body>
</html>

            