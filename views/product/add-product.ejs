<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - MOMENT</title>
    <link rel="stylesheet" href="/css/style.css">
                <link rel="icon" type="image/jpeg" href="/images/MOMENT-logo.jpg">

</head>
<body>
    <%- include('../partials/navbar') %>

    <main>
        <section class="form-section">
            <h1>
                Add Product
            </h1>

            <form
            action="/products"
            method="POST"
            class="form">


            <label for="name">
                Products Name

            </label>


            <input 
            type="text"
            id="name"
            name="name"
            required >


            <label for="description">
                Description
            </label>


            <textarea
            id="description"
            name="description"
            required></textarea>
           

            <label for="price">
                Price BD
            </label>

            <input
            type="number"
            id="price"
            name="price"
            step="0.001"
            required

        >
        <label for="image">
             Product Image
        </label>

        <input
        type="text"
        id="image"
        name="image"
        placeholder="example.jpg"
        required
    >

    <label for="store">
        Store
    </label>

    <select
    id="store"
    name="store"
    required
    >

    <% stores.forEach(store => { %>
        <option
        value="<%= store._id %>">
        <%= store.name %>

    </option>

    <%})  %>
</select>


<button
type="submit"
class="btn">

Add Product
</button>
        </form>

        </section>
    </main>
    <%- include("../partials/footer")%>
</body>
</html>