<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>product</title>
    <link rel="stylesheet" href="/css/style.css">
                <link rel="icon" type="image/jpeg" href="/images/MOMENT-logo.jpg">


</head>
<body>
    <%- include('../partials/navbar') %>
    <main>
        <section class="page-header">
            <h1>Products</h1>

            <% if(user&& user.role === "owner"){ %>
            <a href="/products/new" class="btn">
                Add Product
            </a>
            <% } %>
            <p>
                Explore flowers and cakes available on MOMENT.
            </p>
        </section>

        <section class="product-container">
            <% if(products && products.length > 0)  {%>
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <img
                        src="/images/<%=product.image %>"
                        alt="<%= product.name %>">

                        <div class="product-card-content">
                            <h2>
                                <%= product.name %>
                            </h2>

                            <p>
                                <%= product.description %>
                            </p>


                            <p class="price">
                                <%= product.price %> BD
                            </p>


                            <% if(product.store) {%>
                                <p>
                                    Store: <%= product.store.name %>
                                </p>

                                <% } %>

                                <a
                                href="/products/<%= product._id %>"
                                class="btn">
                            View Product
                        </a>

                          <%if(user&& user.role === "owner"){%>
                            
                           <a href="/products/<%=product._id%>/edit"
                            class="btn">
                            Edit Product
                            </a>
                            <form
                            action="/products/<%= product._id%>?_method=DELETE" 
                            method="POST"
                            style="display: inline;"
                            >

                            <button
                            type="submit"
                            class="btn">
                            Delete product 
                        
                        </button>
                        </form>

                            
                        <%  }%>

                        </div>
                    </div>
                    <% }) %>

                    <% }else{ %>

                        <p class="empty-message">
                            No products available .
                        </p>

                        <% } %>


                  
        </section>
    </main>
    <%- include("../partials/footer")%>
</body>
</html>