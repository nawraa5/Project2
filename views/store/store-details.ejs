<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=store.name %> - MOMENT</title>
    <link rel="stylesheet" href="/css/style.css">
    </head>
<body>
    <%- include("partials/navbar") %>

    <main>
        <section class="store-details">
            <img
            src="/images/<%=store.image %>"
            alt="<%= store.name %>"
            class="store-detials-image">

            <div class="store-detials-content">
                <span class="category">
                    <%= store.category %>
                </span>
                <h1>
                    <%=store.name %>
                </h1>
                <p>
                    <%=store.description %>
                </p>

                <% if(store.owner){ %>
                    <p>
                        Owner:<%= store.owner.username %>
                    </p>
                    <% } %>
            </div>

        </section>



        <section class="products-section">
            <h2>Products</h2>
            <% if(products && products.length > 0) { %>
                <div class="products-container">
                    <% products.forEach(product => { %>
                        <div class="product-card">
                            <img
                            src="/images/<%= product.image %>"
                            alt="<%= product.name %>">

                            <div class="product-card-content">
                                <h3>
                                    <%=product.name %>
                                </h3>
                                <p>
                                    <%= product.description %>
                                </p>

                                <p class="price">
                                    <%= product.price %> BD
                                </p>

                                <a
                                href="/products<%= product._id %>"
                                class="btn">
                            View Product</a>
                            </div>
                        </div>
                        <% }) %>
                </div>


                        <% }else{%>

                            <p class="empty-message">
                                This store has no products yet
                            </p>

                            <% } %>
                </div>


        </section>

        <% if(
            typeof currentUser !=="undefined" &&
            curentUser && store.owner&&
            curentUser._id.toString()=== store.owner._id.toString()

        ){%>

        <div class="action-buttons">
            <a 
            href="/stores/<%=store._id%>/edit"
            class="btn">
            Edit store
            </a>
            <form 
            action="/stores/<%=store._id %>?_method=DELETE"
            method="POST">

            <button 
            type="submit"
            class="delete-btn"
            >
            Delete Store
            </button>
            </form>
            </div>

            <% } %>
    </main>

    <%- include("partials/footer")%>
</body>
</html>