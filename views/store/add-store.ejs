<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Store - MOMENT</title>
    <link rel="stylesheet" href="/css/style.css">
                <link rel="icon" type="image/jpeg" href="/images/MOMENT-logo.jpg">


</head>
<body>
    <%- include("../partials/navbar") %>

    <main>
        <section class="form-section">
            <h1>Add Store</h1>

            <form action="/stores"method="POST" class="form">

            <label for="name">
                Store Name
            </label>

            <input
            type="text"
            id="name"
            name="name"
            required
            >


        <label for="description">
            Description
        </label>

        <textarea
        id="description"
        name="description"
        required>
       
    </textarea>

    <label for="image">
        Image
    </label>


    <input
    type="text"
    id="image"
    name="image"
    placeholder="example.jpg"
    required
    >

    <label for="category">
        Category
    </label>


    <select
    id="category"
    name="category"
    required
    >
   

    <option
    value="flowers">
    Flowers
</option>


<option
    value="cakes">
    Cakes
</option>
    </select>

    <button
    type="submit"
    class="btn"
    >
    Add Store
</button>

         </form>
        </section>
    </main>

    <%- include("../partials/footer") %>



</body>
</html>