<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('./partials/navbar') %>
    <main>
        <section class="hero">
            <div class="hero-content">
    <h1>Make Every Moment Special</h1>

    <p>
        Discover beautiful flowers and delicious cakes
        for every special moment.
    </p>

    <div class="hero-buttons">
        <a href="/stores/flowers" class="btn">
            Explore Flowers
        </a>


        <a href="/stores/cakes" class="btn secondary-btn">
            Explore Cakes
        </a>



    </div>

</div>
</section>

<section class="categories">
    <h2>Choose Your Moment</h2>
    <div class="category-container">
        <a href="/stores/flowers" class="category-card">
        <img src="/images/flowers.jpg" alt="Flowers">
        <div>
            <h3>Flowers</h3>

            <p>
                Beautiful flowers to make every moment
                memorable
            </p>
        </div>
        </a>


        <a href="/stores/cakes" class="category-card">
            <img src="/images/cakes.jpg" alt="Cakes">

            <div>
                <h3>Cakres</h3>
                <p>
                    Delicious cake made for your special moments .
                </p>
            </div>
        </a>
    </div>
</section>
</main>
<%-include("partials/footer")%>


    
</body>
</html>


